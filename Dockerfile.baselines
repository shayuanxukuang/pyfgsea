FROM mambaorg/micromamba:1.5.10

WORKDIR /workspace

COPY environment.baselines.yml /tmp/environment.baselines.yml
RUN micromamba install -y -n base -f /tmp/environment.baselines.yml && micromamba clean -a -y

COPY . /workspace

ENV PATH=/opt/conda/bin:$PATH
ENV CARGO_TARGET_DIR=/tmp/pyfgsea-target
SHELL ["/bin/bash", "-lc"]

RUN micromamba run -n base python -m pip install --no-cache-dir --timeout 300 --retries 10 .

WORKDIR /run

ENTRYPOINT ["micromamba", "run", "-n", "base"]
CMD ["python", "-c", "import pyfgsea; print(pyfgsea.__version__)"]
